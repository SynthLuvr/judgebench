# Copy to .env and fill in the keys you need.
# Load with: judgebench --env-file .env   (or: node --env-file=.env)
# `judgebench smoke` needs no keys.
# Or run `judgebench configure` to set the judge model(s) and keys
# interactively (it writes this file with mode 0600).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Z.ai GLM judges (zai/…), https://api.z.ai
ZAI_API_KEY=
# DeepSeek direct (deepseek/…), https://api.deepseek.com
DEEPSEEK_API_KEY=
# DeepSeek and other open models via OpenCode Go (opencode-go/…), https://opencode.ai/docs/go
OPENCODE_API_KEY=
# Local ONNX weights for the laya engine (laya/… judges); one
# subdirectory per checkpoint (english/, multilingual/, typed-decisions/),
# each exported once with the laya-ts package's scripts/export_onnx.py.
# Unset: checkpoints resolve to the default Hugging Face hub layout.
# LAYA_MODEL_DIR=./models
# Claude Code CLI judges (claude-code/…) need no key: install the claude
# CLI and log in (claude login). judgebench unsets ANTHROPIC_API_KEY /
# ANTHROPIC_AUTH_TOKEN for those CLI processes so they keep using the
# CLI login instead of this key.
